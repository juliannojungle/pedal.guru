{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build: RP2040 Full",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "rm -rf build && mkdir build && cd build && cmake .. -DPLATFORM_NAME=RP2040 && make"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": {
                "owner": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                }
            }
        },
        {
            "label": "Build: ESP32 Full",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "source ~/esp-idf/export.sh && rm -rf build && idf.py -DPLATFORM_NAME=ESP32 build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": {
                "owner": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                }
            }
        },
        {
            "label": "Build: Incremental",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "if [ ! -d build ]; then echo \"No build/ directory: run a Full build task first.\"; exit 1; fi; cd build; [ -f build.ninja ] && source ~/esp-idf/export.sh >/dev/null 2>&1; cmake --build ."
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": {
                "owner": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                }
            }
        },
        {
            "label": "Build: Simulator Incremental",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "if grep -qx PLATFORM_NAME:STRING=Simulator build/CMakeCache.txt 2>/dev/null; then cd build && cmake --build .; else rm -rf build && mkdir build && cd build && cmake .. -DPLATFORM_NAME=Simulator -DCMAKE_BUILD_TYPE=Debug && cmake --build .; fi"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": {
                "owner": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                }
            }
        }
    ]
}
